# Copy to .env and fill in. NEVER commit .env. Synthetic data only — no real PHI.

# ── LLM ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace-me
LLM_MODEL=claude-opus-4-8

# ── Database (Postgres + pgvector) ───────────────────
POSTGRES_USER=health
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=health_ops
DATABASE_URL=postgresql+asyncpg://health:change-me-locally@postgres:5432/health_ops

# ── Queue (RabbitMQ) ─────────────────────────────────
RABBITMQ_USER=health
RABBITMQ_PASSWORD=change-me-locally
RABBITMQ_URL=amqp://health:change-me-locally@rabbitmq:5672/

# ── Cache / locks (Redis) ────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Observability (optional for local dev) ───────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── App ──────────────────────────────────────────────
ENV=local
LOG_LEVEL=INFO
